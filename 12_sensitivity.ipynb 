        "df['in_complete'] = ((df['in_analysis'] == 1) & df[['sex_bin', 'GRADE', ses_col]].notna().all(axis=1)).astype(int)\n",
        "\n",
        "# 3. 민감도 분석용 변수 생성\n",
        "# [S1용] 체중 조절 노력 변수(WC_MN): 1=노력 안 함, 2=줄이려고 노력함, 3=늘리려고 노력함, 4=유지하려고 노력함\n",
        "# -> '체중을 줄이려고 노력함(WC_MN == 2)'인 학생을 제외한 도메인 (WC_MN이 1, 3, 4인 학생)\n",
        "df['in_s1_no_diet'] = ((df['in_complete'] == 1) & (df['WC_MN'].isin([1, 3, 4]))).astype(int)\n",
