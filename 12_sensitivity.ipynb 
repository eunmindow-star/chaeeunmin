        "def fit_svy_domain_glm(family_type, exposure_col, domain_col, data, w_col='W', h_col='STRATA', c_col='CLUSTER'):\n",
        "    \"\"\"\n",
        "    행 삭제 없이 전체 54,170명을 유지한 상태에서\n",
        "    family_type ('logit' -> OR, 'poisson' -> PR)으로 설계 기반(W, STRATA, CLUSTER) 회귀를 적합한다.\n",
        "    \"\"\"\n",
        "    d = (data[domain_col] == 1)\n",
        "    w_all = np.where(d, data[w_col], 0.0)\n",
        "    w_all = np.where(d, w_all / w_all[d].mean(), 0.0)\n",
        "\n",
        "    y_ser = data['obesity'].fillna(0).values\n",
        "    tmp = data[[exposure_col, 'sex_bin', 'GRADE', ses_col]].copy()\n",
        "    for v in [exposure_col, 'sex_bin', 'GRADE', ses_col]:\n",
        "        tmp[v] = tmp[v].fillna(tmp.loc[d, v].mode()[0])\n",
        "\n",
        "    X_df = pd.get_dummies(\n",
        "        tmp[[exposure_col, 'sex_bin', 'GRADE', ses_col]],\n",
        "        columns=['sex_bin', 'GRADE', ses_col],\n",
        "        drop_first=True,\n",
        "        dtype=float\n",
        "    )\n",
        "    X_df.insert(0, 'Intercept', 1.0)\n",
        "    X = X_df.values\n",
        "    col_names = list(X_df.columns)\n",
        "\n",
        "    # 1) 가중 최대우도/의사우도 점추정치 산출\n",
        "    beta = np.zeros(X.shape[1])\n",
        "    for _ in range(40):\n",
        "        eta = np.clip(X @ beta, -20, 20)\n",
        "        if family_type == 'logit':\n",
        "            mu = 1.0 / (1.0 + np.exp(-eta))\n",
        "            V = mu * (1.0 - mu)\n",
        "        elif family_type == 'poisson':\n",
        "            mu = np.exp(eta)\n",
        "            V = mu  # 포아송 정준 연결(로그 연결) 작업 가중치\n",
        "        score = X.T @ (w_all * (y_ser - mu))\n",
        "        hess = X.T @ (X * (w_all * V)[:, None]) + 1e-6 * np.eye(X.shape[1])\n",
        "        try:\n",
        "            step = la.solve(hess, score, assume_a='pos')\n",
        "        except la.LinAlgError:\n",
        "            step = la.pinv(hess) @ score\n",
        "        beta += step\n",
        "        if np.max(np.abs(step)) < 1e-10:\n",
        "            break\n",
        "\n",
        "    # 2) 설계 기반 샌드위치 분산-공분산 행렬 (층 STRATA, 집락 CLUSTER 반영)\n",
        "    eta = np.clip(X @ beta, -20, 20)\n",
        "    if family_type == 'logit':\n",
        "        mu = 1.0 / (1.0 + np.exp(-eta))\n",
        "        V = mu * (1.0 - mu)\n",
        "    else:\n",
        "        mu = np.exp(eta)\n",
        "        V = mu\n",
        "\n",
        "    hess_inv = la.pinv(X.T @ (X * (w_all * V)[:, None]) + 1e-6 * np.eye(X.shape[1]))\n",
        "    U = X * (w_all * (y_ser - mu))[:, None]\n",
        "    u_df = pd.DataFrame(U, columns=col_names)\n",
        "    u_df['h'] = data[h_col].values\n",
        "    u_df['c'] = data[c_col].values\n",
        "\n",
        "    psu_sum = u_df.groupby(['h', 'c'])[col_names].sum().reset_index()\n",
        "    G_meat = np.zeros((len(col_names), len(col_names)))\n",
        "    for _, g in psu_sum.groupby('h'):\n",
        "        nh = len(g)\n",
        "        if nh > 1:\n",
        "            g_mat = g[col_names].values\n",
        "            g_diff = g_mat - g_mat.mean(axis=0, keepdims=True)\n",
        "            G_meat += (nh / (nh - 1)) * (g_diff.T @ g_diff)\n",
        "\n",
        "    cov_beta = hess_inv @ G_meat @ hess_inv\n",
        "    se_beta = np.sqrt(np.diag(cov_beta))\n",
        "\n",
        "    idx = col_names.index(exposure_col)\n",
        "    b_val = beta[idx]\n",
        "    se_val = se_beta[idx]\n",
        "    p_val = 2 * (1 - norm.cdf(abs(b_val / se_val)))\n",
        "\n",
        "    return int(d.sum()), np.exp(b_val), np.exp(b_val - 1.96 * se_val), np.exp(b_val + 1.96 * se_val), p_val\n",
        "\n",
        "# 4가지 모형 실행 (모두 성별·학년·경제상태 보정)\n",
        "n0, est0, l0, h0, p0 = fit_svy_domain_glm('logit', 'bf_skip', 'in_complete', df)         # 주모형 (Model 2)\n",
        "n1, est1, l1, h1, p1 = fit_svy_domain_glm('logit', 'bf_skip', 'in_s1_no_diet', df)       # S1: 체중 감량 노력군 제외\n",
        "np_, estp, lp, hp, pp = fit_svy_domain_glm('poisson', 'bf_skip', 'in_complete', df)      # S-유병률비: 포아송 로그연결\n",
        "n2, est2, l2, h2, p2 = fit_svy_domain_glm('logit', 'bf_skip_3plus', 'in_complete', df)   # S2: 노출 정의 주 3회 이상\n",
        "\n",
        "sens_table = pd.DataFrame([\n",
        "    {\n",
        "        '분석 구분': '주모형 (11주차 Model 2, 기준)',\n",
        "        '분석 조건 및 도메인': '주 5회 이상 결식 / 로지스틱 회귀',\n",
        "        '분석 인원 (N)': f\"{n0:,}\",\n",
        "        '지표': 'Adjusted OR',\n",
        "        '추정치 (95% CI)': f\"{est0:.2f} ({l0:.2f}–{h0:.2f})\",\n",
        "        'p-value': f\"{p0:.4f}\"\n",
        "    },\n",
        "    {\n",
        "        '분석 구분': 'S1: 역방향 인과 점검',\n",
        "        '분석 조건 및 도메인': '체중 감량 시도자(WC_MN=2) 제외 도메인',\n",
        "        '분석 인원 (N)': f\"{n1:,}\",\n",
        "        '지표': 'Adjusted OR',\n",
        "        '추정치 (95% CI)': f\"{est1:.2f} ({l1:.2f}–{h1:.2f})\",\n",
        "        'p-value': f\"{p1:.4f}\"\n",
        "    },\n",
        "    {\n",
        "        '분석 구분': 'S-유병률비: 모형 변경 (필수)',\n",
        "        '분석 조건 및 도메인': '동일 표본 / 포아송 회귀(로그 연결)',\n",
        "        '분석 인원 (N)': f\"{np_:,}\",\n",
        "        '지표': 'Adjusted PR',\n",
        "        '추정치 (95% CI)': f\"{estp:.2f} ({lp:.2f}–{hp:.2f})\",\n",
        "        'p-value': f\"{pp:.4f}\"\n",
        "    },\n",
        "    {\n",
        "        '분석 구분': 'S2: 노출 정의 변경',\n",
        "        '분석 조건 및 도메인': '아침 결식 기준 완화 (주 3회 이상)',\n",
        "        '분석 인원 (N)': f\"{n2:,}\",\n",
        "        '지표': 'Adjusted OR',\n",
        "        '추정치 (95% CI)': f\"{est2:.2f} ({l2:.2f}–{h2:.2f})\",\n",
        "        'p-value': f\"{p2:.4f}\"\n",
        "    }\n",
        "])\n",
        "\n",
        "print(\"=== [12주차 민감도 분석 결과 비교표] ===\")\n",
        "display(sens_table)"
