        "df['bmi'] = df['WT'] / ((df['HT'] / 100) ** 2)\n",
        "df['obesity'] = np.where(df['bmi'] >= 25, 1,\n",
        "                         np.where(df['bmi'].notna(), 0, np.nan))\n",
        "\n",
        "# 보정변수 (성별, 학년, 경제상태)\n",
